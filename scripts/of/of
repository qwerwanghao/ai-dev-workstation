#!/usr/bin/env zsh
CONFIG_DIR="$HOME/.config/of"
CONFIG_FILE="$CONFIG_DIR/projects.json"
PYTHON_BIN="${PYTHON_BIN:-python3}"

# Detect language for messages (default to English)
detect_lang() {
  if [[ -n "$LC_ALL" ]]; then
    echo "${LC_ALL%%.*}"
  elif [[ -n "$LANG" ]]; then
    echo "${LANG%%.*}"
  else
    echo "en"
  fi
}

LANG_CODE=$(detect_lang)

# Message strings
msg() {
  local key="$1"
  case "$key" in
    err_project_required)
      if [[ "$LANG_CODE" =~ ^zh ]]; then
        echo "Error: Project name is required."
      else
        echo "Error: Project name is required."
      fi
      ;;
    usage_register)
      if [[ "$LANG_CODE" =~ ^zh ]]; then
        echo "Usage: of register <name> [--win=<path>] [--editor=<editor>]"
      else
        echo "Usage: of register <name> [--win=<path>] [--editor=<editor>]"
      fi
      ;;
    err_wslpath)
      if [[ "$LANG_CODE" =~ ^zh ]]; then
        echo "Error: wslpath not found. Please specify --win=<path>"
      else
        echo "Error: wslpath not found. Please specify --win=<path>"
      fi
      ;;
    err_not_git)
      if [[ "$LANG_CODE" =~ ^zh ]]; then
        echo "Error: Not a Git repository"
      else
        echo "Error: Not a Git repository"
      fi
      ;;
    err_project_exists)
      if [[ "$LANG_CODE" =~ ^zh ]]; then
        echo "Project '$1' already exists. Use 'of use $1' to switch to it."
      else
        echo "Project '$1' already exists. Use 'of use $1' to switch to it."
      fi
      ;;
    project_registered)
      if [[ "$LANG_CODE" =~ ^zh ]]; then
        echo "Project '$1' registered:"
        echo "  WSL path: $2"
        echo "  Win path: $3"
        echo "  Editor: $4"
      else
        echo "Project '$1' registered:"
        echo "  WSL path: $2"
        echo "  Win path: $3"
        echo "  Editor: $4"
      fi
