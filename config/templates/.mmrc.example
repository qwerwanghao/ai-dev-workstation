# Example mm configuration file
# Copy this to ~/.mmrc and customize for your project

# Project Configuration
PROJECT_NAME="my-project"
PROJECT_DIR="/path/to/your/project"
PROJECT_WIN="D:\\Projects\\my-project"
PROJECT_TYPE="generic"

# Windows Drive Mounts (for WSL2)
WINDOWS_DRIVE_F="/mnt/f"
WINDOWS_DRIVE_C="/mnt/c"

# Application Paths (Windows format)
declare -A APPS
APPS[code]="C:\\Program Files\\Microsoft VS Code\\Code.exe"
APPS[vs]="C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\IDE\\devenv.exe"
APPS[rider]="C:\\Users\\yourname\\AppData\\Local\\Programs\\Rider\\bin\\rider64.exe"
APPS[unity]="C:\\Program Files\\Unity Hub\\Unity Hub.exe"

# Zellij Configuration
ZELLIJ_LAYOUT="ai_workstation"

# Custom Commands
declare -A CMDS
CMDS[build]="echo 'Configure your build command here'"
CMDS[test]="echo 'Configure your test command here'"
CMDS[run]="echo 'Configure your run command here'"

# Workspace Applications (launched by 'mm')
WORKSPACE_APPS=("code")
