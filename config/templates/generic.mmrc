# Generic Project Template
# PROJECT_TYPE: generic
# Use this for projects that don't fit specific categories

PROJECT_NAME="my-project"
PROJECT_DIR="/path/to/project"
PROJECT_WIN="D:\\Projects\\my-project"
PROJECT_TYPE="generic"

# Windows Drive Mounts
WINDOWS_DRIVE_F="/mnt/f"
WINDOWS_DRIVE_C="/mnt/c"

# Application Paths
declare -A APPS
APPS[code]="C:\\Program Files\\Microsoft VS Code\\Code.exe"

# Zellij Configuration
ZELLIJ_LAYOUT="minimal"

# Custom Commands
declare -A CMDS
CMDS[build]="make build"
CMDS[test]="make test"
CMDS[run]="make run"
CMDS[clean]="make clean"

# Workspace Applications
WORKSPACE_APPS=("code")
